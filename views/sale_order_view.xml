<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit_image_barcode" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.image.barcode</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list/field[@name='product_template_id']" position="after">
                <field name="product_image"
                       widget="image"
                       options="{'size': [48, 48]}"
                       string="Product Image"
                       optional="show"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='product_id']" position="before">

                <field name="product_barcode"
                       string="Barcode/ISBN"
                       optional="show"
                       readonly="0"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='product_uom_qty']" position="before">
                <!--                <field name="qty_available" string="Qty On Hand"/>-->
                <!--                <field name="virtual_available" string="Forecast Qty"/>-->
                <field name="warehouse_id"/>
            </xpath>

            <xpath expr="//field[@name='order_line']/list/field[@name='product_uom_qty']"
                   position="before">

                <field name="qty_on_hand"
                       string="Qty On Hand"
                       optional="show"/>

            </xpath>
        </field>
    </record>
</odoo>