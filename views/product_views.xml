<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_barcode_label_inherit" model="ir.ui.view">
        <field name="name">product.template.form.barcode.label.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='standard_price_uom']/following-sibling::field[@name='barcode'][1]"
                   position="attributes">
                <attribute name="string">Barcode/ISBN</attribute>
            </xpath>
        </field>
    </record>

    <record id="product_product_form_barcode_label_inherit" model="ir.ui.view">
        <field name="name">product.product.form.barcode.label.inherit</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='standard_price_uom']/following-sibling::field[@name='barcode'][1]"
                   position="attributes">
                <attribute name="string">Barcode/ISBN</attribute>
            </xpath>
        </field>
    </record>

      <record id="product_template_tree_barcode_custom" model="ir.ui.view">
        <field name="name">product.template.tree.barcode.custom</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='default_code']" position="after">
                <field name="barcode" string="Barcode/ISBN" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="product_template_kanban_view_barcode" model="ir.ui.view">
        <field name="name">product.template.kanban.barcode</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_kanban_view"/>
        <field name="arch" type="xml">
            <xpath expr="//templates" position="before">
                <field name="barcode"/>
            </xpath>
            <xpath expr="//field[@name='list_price']" position="after">
                <div t-if="record.barcode.raw_value">
                    Barcode/ISBN: <field name="barcode"/>
                </div>
            </xpath>
        </field>
    </record>

    <record id="product_kanban_view_barcode" model="ir.ui.view">
        <field name="name">product.product.kanban.barcode</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_kanban_view"/>
        <field name="arch" type="xml">
            <xpath expr="//templates" position="before">
                <field name="barcode"/>
            </xpath>
            <xpath expr="//field[@name='lst_price']" position="after">
                <div t-if="record.barcode.raw_value">
                    Barcode/ISBN: <field name="barcode"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>